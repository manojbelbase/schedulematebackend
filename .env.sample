PORT = 8000
NODE_ENV = development
LOG_LEVEL = info
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/schedulemate"
JWT_SECRET="change-me-secret"
# Separate secret for OAuth "state" tokens (Google login + calendar connect).
# MUST be set, and should differ from JWT_SECRET.
JWT_STATE_SECRET="change-me-state-secret"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="14d"

MEMORY_EXTRACTION_ENABLED="true"

DOCS_AUTH_TOKEN=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"
FRONTEND_URL="http://localhost:3000"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

ADMIN_EMAIL=""

# Password reset OTP
OTP_TTL_MINUTES=10


CORS_ORIGINS="http://localhost:3000,https://localhost:3000,http://localhost:3001,https://localhost:3001,http://localhost:3002,https://localhost:3002,http://127.0.0.1:3000,https://127.0.0.1:3000"
GOOGLE_CONNECT_REDIRECT_URI="http://localhost:8000/api/calendar-connection/connect/callback"
